{
    "name": "@cbnsndwch/fetch-incoming-message",
    "description": "An experimental IncomingMessage ",
    "type": "module",
    "scripts": {
        "prepublishOnly": "pnpm run build",
        "clean": "rimraf lib coverage",
        "build": "pnpm clean && pnpm build:esm",
        "build:esm": "tsc -b tsconfig.build.json",
        "dev": "tsc -b tsconfig.build.json -w",
        "sb": "storybook dev -p 6006",
        "sb:docs": "storybook dev -p 6006 --docs",
        "sb:build": "storybook build",
        "prepublish": "pnpm build --force",
        "pub": "pnpm publish",
        "format": "oxfmt src",
        "lint": "oxlint src",
        "lint:fix": "oxlint --fix src",
        "test": "vitest --run --passWithNoTests",
        "ci:test": "vitest --run --passWithNoTests --bail 1",
        "test:all": "vitest --run --passWithNoTests",
        "test:watch": "vitest",
        "test:ui": "vitest --ui --passWithNoTests",
        "coverage": "vitest --coverage"
    },
    "dependencies": {
        "@mjackson/headers": "^0.8.0",
        "undici": "^6.21.0"
    },
    "devDependencies": {
        "@types/express": "^4",
        "@types/node": "^22.9.1",
        "@vitejs/plugin-react": "^4.3.2",
        "@vitest/coverage-v8": "2.1.4",
        "@vitest/ui": "2.1.4",
        "artillery": "^2.0.21",
        "express": "^4.21.1",
        "oxfmt": "^0.35.0",
        "oxlint": "^1.50.0",
        "rimraf": "^5.0.7",
        "tsx": "^4.19.2",
        "typescript": "~5.6.3",
        "undici-types": "^6.21.0",
        "vite": "5.4.10",
        "vite-plugin-checker": "^0.8.0",
        "vite-tsconfig-paths": "^5.1.0",
        "vitest": "2.1.4"
    },
    "packageManager": "pnpm@9.15.4"
}
