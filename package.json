{
    "name": "@cbnsndwch/fetch-incoming-message",
    "description": "An experimental fetch-aligned IncomingMessage implementation for node:http",
    "version": "0.1.0",
    "type": "module",
    "repository": {
        "url": "https://github.com/cbnsndwch/fetch-incoming-message"
    },
    "author": {
        "name": "Sergio leon",
        "url": "https://cbnsndwch.io"
    },
    "scripts": {
        "prepublishOnly": "pnpm run build",
        "clean": "rimraf lib coverage",
        "build": "pnpm clean && pnpm build:esm",
        "build:esm": "tsc -b tsconfig.build.json",
        "dev": "tsc -b tsconfig.build.json -w",
        "sb": "storybook dev -p 6006",
        "sb:docs": "storybook dev -p 6006 --docs",
        "sb:build": "storybook build",
        "prepublish": "pnpm build --force",
        "pub": "pnpm publish",
        "format": "oxfmt src",
        "lint": "oxlint src",
        "lint:fix": "oxlint --fix src",
        "test": "vitest --run --passWithNoTests",
        "ci:test": "vitest --run --passWithNoTests --bail 1",
        "test:all": "vitest --run --passWithNoTests",
        "test:watch": "vitest",
        "test:ui": "vitest --ui --passWithNoTests",
        "coverage": "vitest --coverage"
    },
    "dependencies": {
        "@mjackson/headers": "^0.11.1",
        "undici": "^7.22.0"
    },
    "devDependencies": {
        "@types/express": "^5",
        "@types/node": "^24",
        "@vitest/coverage-v8": "4.0.18",
        "@vitest/ui": "4.0.18",
        "artillery": "^2.0.30",
        "express": "^5.2.1",
        "npm-check-updates": "^19.5.0",
        "oxc": "^1.0.1",
        "oxfmt": "^0.35.0",
        "oxlint": "^1.50.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "undici-types": "^7.22.0",
        "vite": "7.3.1",
        "vite-plugin-checker": "^0.12.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "4.0.18"
    },
    "packageManager": "pnpm@10.30.3"
}
