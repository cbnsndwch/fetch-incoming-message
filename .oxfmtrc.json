{
    "ignorePatterns": [
        ".editorconfig",
        ".env",
        ".gitignore",
        ".prettierignore",
        ".prettierrc",
        ".vscode",
        ".yarn",
        ".yarnrc.yml",
        "assets",
        "CHANGELOG.md",
        "dist",
        "docs",
        "node_modules",
        "pnpm-lock.yaml"
    ],
    "singleQuote": true,
    "bracketSpacing": true,
    "trailingComma": "none",
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "semi": true,
    "arrowParens": "avoid",
    "overrides": [
        {
            "files": [
                "*.puml",
                "*.yml"
            ],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
